# Graph and Vector Store Configuration
GRAPH_STORE=neptune://your-neptune-endpoint:8182
VECTOR_STORE=opensearch://your-opensearch-endpoint

# AWS Configuration
AWS_REGION=us-east-1
S3_BUCKET=your-graphrag-demo-bucket

# Optional: AWS Credentials (if not using IAM roles)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# Bedrock models used by graphrag-toolkit (GraphRAGConfig env vars)
# Extraction LLM -> entity/relationship extraction during indexing
# Response LLM   -> final answer generation during query
# Embeddings     -> vector embedding model + dimensions for the vector store
# Use Bedrock model IDs or US cross-region inference profile IDs (prefix with us.)
EXTRACTION_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
RESPONSE_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
EMBEDDINGS_MODEL=amazon.titan-embed-text-v2:0
EMBEDDINGS_DIMENSIONS=1024
